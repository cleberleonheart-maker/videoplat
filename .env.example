# ─── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=videoplat
POSTGRES_PASSWORD=videoplat
POSTGRES_DB=videoplat
DATABASE_URL=postgresql://videoplat:videoplat@localhost:5432/videoplat?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://api:4000

# ─── Object storage (MinIO em dev, S3 em prod) ───────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Endpoint público (alcançável pelo browser) usado para assinar as URLs de
# upload. Deixe vazio quando S3_ENDPOINT já for público.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=videoplat
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PUBLIC_MEDIA_URL=http://localhost:9000/videoplat

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=troque-este-secreto-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WEB_URL=http://localhost:3000

# ─── Encoding ────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_SEGMENT_SECONDS=6
ENCODE_CONCURRENCY=2
